{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borek.ai/contracts/borek_design_tokens.schema.json",
  "title": "BorekDesignTokens",
  "description": "TSK-010 approved presentation branding tokens (JJ-26 CI).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "description",
    "authority",
    "colors",
    "surfaces",
    "typography",
    "borek_logo",
    "client_logo",
    "gamma_branding",
    "fallback_renderer"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentation_engine", "documents"],
      "properties": {
        "presentation_engine": {
          "const": "gamma"
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "heading", "accent", "card_background"],
      "properties": {
        "primary": { "$ref": "#/$defs/primaryColorToken" },
        "heading": { "$ref": "#/$defs/headingColorToken" },
        "accent": { "$ref": "#/$defs/accentColorToken" },
        "card_background": { "$ref": "#/$defs/cardBackgroundColorToken" }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cover"],
      "properties": {
        "cover": {
          "type": "object",
          "additionalProperties": false,
          "required": ["appearance", "hex", "source"],
          "properties": {
            "appearance": { "const": "dark" },
            "hex": { "type": "null" },
            "source": { "type": "string", "minLength": 1 },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading_font", "body_font"],
      "properties": {
        "heading_font": { "$ref": "#/$defs/fontToken" },
        "body_font": { "$ref": "#/$defs/fontToken" }
      }
    },
    "borek_logo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placement", "every_card", "runtime_overridable", "source"],
      "properties": {
        "placement": { "const": "bottom_left_header_footer" },
        "every_card": { "const": true },
        "runtime_overridable": { "const": false },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "client_logo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "slot",
        "cards",
        "position",
        "max_height_pct",
        "min_clear_space_pct",
        "co_brand_with_borek_logo",
        "enabled_by_stage_profile_field"
      ],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "slot": { "const": "cover.client_logo" },
        "cards": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 2
        },
        "position": { "const": "bottom_right" },
        "max_height_pct": { "type": "number", "const": 6.0 },
        "min_clear_space_pct": { "type": "number", "const": 3.0 },
        "co_brand_with_borek_logo": { "const": true },
        "enabled_by_stage_profile_field": { "const": "client_logo" }
      }
    },
    "gamma_branding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locked",
        "locked_keys",
        "locked_keys_source",
        "theme_id_setting",
        "template_id_setting",
        "request_override_forbidden",
        "source"
      ],
      "properties": {
        "locked": { "const": true },
        "locked_keys": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "locked_keys_source": { "type": "string", "minLength": 1 },
        "theme_id_setting": { "const": "GAMMA_THEME_ID" },
        "template_id_setting": { "const": "GAMMA_TEMPLATE_ID" },
        "request_override_forbidden": { "const": true },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "fallback_renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_path", "purpose", "equivalent_mappings"],
      "properties": {
        "token_path": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "equivalent_mappings": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object" }
        }
      }
    }
  },
  "$defs": {
    "colorTokenBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hex", "source"],
      "properties": {
        "hex": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
        "source": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "primaryColorToken": {
      "allOf": [
        { "$ref": "#/$defs/colorTokenBase" },
        { "properties": { "hex": { "const": "2C567A" } } }
      ]
    },
    "headingColorToken": {
      "allOf": [
        { "$ref": "#/$defs/colorTokenBase" },
        { "properties": { "hex": { "const": "0D1D51" } } }
      ]
    },
    "accentColorToken": {
      "allOf": [
        { "$ref": "#/$defs/colorTokenBase" },
        { "properties": { "hex": { "const": "0072C7" } } }
      ]
    },
    "cardBackgroundColorToken": {
      "allOf": [
        { "$ref": "#/$defs/colorTokenBase" },
        { "properties": { "hex": { "const": "FFFFFF" } } }
      ]
    },
    "fontToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "source"],
      "properties": {
        "family": { "const": "Inter" },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
