{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borek.ai/contracts/borek_design_tokens.schema.json",
  "title": "BorekDesignTokens",
  "description": "TSK-010 / TSK-014 approved presentation branding tokens (Arbios definitive master, schema 2.0).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "description",
    "authority",
    "canvas",
    "colors",
    "semantic_accents",
    "surfaces",
    "typography",
    "cards",
    "borek_logo",
    "footer",
    "client_logo",
    "gamma_branding",
    "fallback_renderer"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "description": { "type": "string", "minLength": 1 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentation_engine", "documents"],
      "properties": {
        "presentation_engine": { "const": "gamma" },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_px",
        "height_px",
        "content_margin_px",
        "cover_margin_px",
        "content_top_px",
        "content_bottom_px",
        "source"
      ],
      "properties": {
        "width_px": { "const": 1920 },
        "height_px": { "const": 1080 },
        "content_margin_px": { "const": 72 },
        "cover_margin_px": { "const": 115 },
        "content_top_px": { "const": 300 },
        "content_bottom_px": { "const": 930 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "heading",
        "body",
        "kicker",
        "accent",
        "card_background",
        "card_panel",
        "card_border",
        "footer_muted"
      ],
      "properties": {
        "primary": { "$ref": "#/$defs/navyColorToken" },
        "heading": { "$ref": "#/$defs/navyColorToken" },
        "body": { "$ref": "#/$defs/bodyColorToken" },
        "kicker": { "$ref": "#/$defs/kickerColorToken" },
        "accent": { "$ref": "#/$defs/accentColorToken" },
        "card_background": { "$ref": "#/$defs/whiteColorToken" },
        "card_panel": { "$ref": "#/$defs/panelColorToken" },
        "card_border": { "$ref": "#/$defs/borderColorToken" },
        "footer_muted": { "$ref": "#/$defs/footerMutedColorToken" }
      }
    },
    "semantic_accents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_suite", "ai_projects", "ai_department", "divider_bar"],
      "properties": {
        "ai_suite": { "$ref": "#/$defs/semanticAccentToken" },
        "ai_projects": { "$ref": "#/$defs/semanticAccentToken" },
        "ai_department": { "$ref": "#/$defs/semanticAccentToken" },
        "divider_bar": { "$ref": "#/$defs/semanticAccentToken" }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cover", "content_slide"],
      "properties": {
        "cover": {
          "type": "object",
          "additionalProperties": false,
          "required": ["appearance", "hex", "source"],
          "properties": {
            "appearance": { "const": "dark" },
            "hex": { "const": "0D1240" },
            "source": { "type": "string", "minLength": 1 }
          }
        },
        "content_slide": {
          "type": "object",
          "additionalProperties": false,
          "required": ["appearance", "hex", "source"],
          "properties": {
            "appearance": { "const": "light" },
            "hex": { "const": "FFFFFF" },
            "source": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading_font", "body_font", "scale_px", "rules"],
      "properties": {
        "heading_font": { "$ref": "#/$defs/fontToken" },
        "body_font": { "$ref": "#/$defs/fontToken" },
        "scale_px": { "type": "object", "minProperties": 4 },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "cards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fill_hex", "border_hex", "border_width_px", "radius_px", "source"],
      "properties": {
        "fill_hex": { "const": "F3F4F8" },
        "border_hex": { "const": "E4E7F0" },
        "border_width_px": { "const": 1 },
        "radius_px": { "const": 20 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "borek_logo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["every_card", "runtime_overridable", "asset_dark", "asset_light", "rules", "placements", "source"],
      "properties": {
        "every_card": { "const": true },
        "runtime_overridable": { "const": false },
        "asset_dark": { "const": "logo-dark-2.svg" },
        "asset_light": { "const": "logo-white-2.svg" },
        "rules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "placements": { "type": "object", "minProperties": 4 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_top_px",
        "left_px",
        "right_px",
        "font_size_px",
        "letter_spacing_px",
        "transform",
        "color_hex",
        "left_text",
        "right_text_pattern",
        "source"
      ],
      "properties": {
        "position_top_px": { "const": 1000 },
        "left_px": { "const": 72 },
        "right_px": { "const": 72 },
        "font_size_px": { "const": 15 },
        "letter_spacing_px": { "const": 2.6 },
        "transform": { "const": "uppercase" },
        "color_hex": { "const": "9AA0B3" },
        "left_text": {
          "const": "Borek Solutions Group · boreksolutions.de · Confidential"
        },
        "right_text_pattern": { "const": "{page} / {total}" },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "client_logo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "slot",
        "cards",
        "position",
        "max_height_pct",
        "min_clear_space_pct",
        "co_brand_with_borek_logo",
        "enabled_by_stage_profile_field"
      ],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "slot": { "const": "cover.client_logo" },
        "cards": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 2
        },
        "position": { "const": "bottom_right" },
        "max_height_pct": { "type": "number", "const": 6.0 },
        "min_clear_space_pct": { "type": "number", "const": 3.0 },
        "co_brand_with_borek_logo": { "const": true },
        "enabled_by_stage_profile_field": { "const": "client_logo" }
      }
    },
    "gamma_branding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locked",
        "locked_keys",
        "locked_keys_source",
        "theme_id_setting",
        "template_id_setting",
        "request_override_forbidden",
        "design_contract_version",
        "source"
      ],
      "properties": {
        "locked": { "const": true },
        "locked_keys": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "locked_keys_source": { "type": "string", "minLength": 1 },
        "theme_id_setting": { "const": "GAMMA_THEME_ID" },
        "template_id_setting": { "const": "GAMMA_TEMPLATE_ID" },
        "request_override_forbidden": { "const": true },
        "design_contract_version": { "const": "2.0" },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "fallback_renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_path", "purpose", "equivalent_mappings"],
      "properties": {
        "token_path": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "equivalent_mappings": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object" }
        }
      }
    }
  },
  "$defs": {
    "colorTokenBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hex", "source"],
      "properties": {
        "hex": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
        "source": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "usage": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "navyColorToken": {
      "allOf": [
        { "$ref": "#/$defs/colorTokenBase" },
        { "properties": { "hex": { "const": "0D1240" } } }
      ]
    },
    "bodyColorToken": {
      "allOf": [
        { "$ref": "#/$defs/colorTokenBase" },
        { "properties": { "hex": { "const": "515C70" } } }
      ]
    },
    "kickerColorToken": {
      "allOf": [
        { "$ref": "#/$defs/colorTokenBase" },
        { "properties": { "hex": { "const": "8A90A5" } } }
      ]
    },
    "accentColorToken": {
      "allOf": [
        { "$ref": "#/$defs/colorTokenBase" },
        { "properties": { "hex": { "const": "124F94" } } }
      ]
    },
    "whiteColorToken": {
      "allOf": [
        { "$ref": "#/$defs/colorTokenBase" },
        { "properties": { "hex": { "const": "FFFFFF" } } }
      ]
    },
    "panelColorToken": {
      "allOf": [
        { "$ref": "#/$defs/colorTokenBase" },
        { "properties": { "hex": { "const": "F3F4F8" } } }
      ]
    },
    "borderColorToken": {
      "allOf": [
        { "$ref": "#/$defs/colorTokenBase" },
        { "properties": { "hex": { "const": "E4E7F0" } } }
      ]
    },
    "footerMutedColorToken": {
      "allOf": [
        { "$ref": "#/$defs/colorTokenBase" },
        { "properties": { "hex": { "const": "9AA0B3" } } }
      ]
    },
    "semanticAccentToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hex", "source"],
      "properties": {
        "hex": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "fontToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "source"],
      "properties": {
        "family": { "const": "Inter" },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
