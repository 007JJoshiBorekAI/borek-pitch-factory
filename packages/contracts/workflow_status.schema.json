{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borek.ai/contracts/workflow_status.schema.json",
  "title": "WorkflowStatus",
  "description": "BT-47 authoritative Discovery-first workflow status and document lineage. current_status is the earliest incomplete step. Later evidence stays visible. This object is derived on read except for three stored milestone timestamps.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "opportunity_id", "current_status", "steps", "documents"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "opportunity_id": { "type": "string", "format": "uuid" },
    "current_status": { "$ref": "#/$defs/StepKey" },
    "steps": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/Step" }
    },
    "documents": { "$ref": "#/$defs/Documents" }
  },
  "$defs": {
    "StepKey": {
      "type": "string",
      "enum": [
        "client_information",
        "discovery_prepared",
        "ppt1_ready",
        "first_meeting_completed",
        "transcript_added",
        "ppt2_generated",
        "owner_review",
        "finalized"
      ]
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "state", "completed_at", "evidence"],
      "properties": {
        "key": { "$ref": "#/$defs/StepKey" },
        "state": { "type": "string", "enum": ["completed", "current", "pending"] },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "evidence": { "type": "object" }
      }
    },
    "Documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_draft", "approved_discovery", "ppt1", "ppt2"],
      "properties": {
        "discovery_draft": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["document_id", "status", "differs_from_approved"],
          "properties": {
            "document_id": { "type": "string", "format": "uuid" },
            "status": { "type": "string", "minLength": 1 },
            "differs_from_approved": { "type": ["boolean", "null"] }
          }
        },
        "approved_discovery": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["version_id", "version_number", "document_id"],
          "properties": {
            "version_id": { "type": "string", "format": "uuid" },
            "version_number": { "type": "integer" },
            "document_id": { "type": "string", "format": "uuid" }
          }
        },
        "ppt1": { "$ref": "#/$defs/DeckLineage" },
        "ppt2": { "$ref": "#/$defs/DeckLineage" }
      }
    },
    "DeckLineage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["presentation_id", "latest_ready_version_id", "journey_stage", "status"],
      "properties": {
        "presentation_id": { "type": "string", "format": "uuid" },
        "latest_ready_version_id": { "type": ["string", "null"], "format": "uuid" },
        "journey_stage": { "type": "string", "enum": ["first_contact", "post_meeting"] },
        "status": { "type": "string", "minLength": 1 }
      }
    }
  }
}
