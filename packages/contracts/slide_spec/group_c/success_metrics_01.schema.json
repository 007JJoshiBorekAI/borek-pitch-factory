{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borek.ai/schemas/slide_spec/group_c/success_metrics_01/v1.0",
  "title": "SuccessMetrics01SlideSpec",
  "description": "MS-3: content contract for the SUCCESS_METRICS_01 Borek layout. Criteria only; no money or currency fields.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    { "$ref": "../base.schema.json#/$defs/SlideSpecBase" }
  ],
  "properties": {
    "schema_version": { "$ref": "../base.schema.json#/properties/schema_version" },
    "slideId": { "$ref": "../base.schema.json#/properties/slideId" },
    "layoutId": { "const": "SUCCESS_METRICS_01" },
    "sectionLabel": { "$ref": "../base.schema.json#/properties/sectionLabel" },
    "title": { "$ref": "../base.schema.json#/properties/title" },
    "subtitle": { "$ref": "../base.schema.json#/properties/subtitle" },
    "sourceChapterIds": { "$ref": "../base.schema.json#/properties/sourceChapterIds" },
    "fieldProvenance": { "$ref": "../base.schema.json#/properties/fieldProvenance" },
    "criteria": {
      "type": "array",
      "description": "Non-monetary success criteria; item-count limits are defined separately in MS-12.",
      "items": { "$ref": "#/$defs/SuccessCriterion" }
    }
  },
  "required": ["schema_version", "layoutId", "title", "sourceChapterIds", "criteria"],
  "$defs": {
    "SuccessCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
