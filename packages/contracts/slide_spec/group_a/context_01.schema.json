{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borek.ai/schemas/slide_spec/group_a/context_01/v1.0",
  "title": "Context01SlideSpec",
  "description": "BT-5: semantic four-area content contract for the CONTEXT_01 Borek layout.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    { "$ref": "../base.schema.json#/$defs/SlideSpecBase" }
  ],
  "properties": {
    "schema_version": { "$ref": "../base.schema.json#/properties/schema_version" },
    "slideId": { "$ref": "../base.schema.json#/properties/slideId" },
    "layoutId": { "const": "CONTEXT_01" },
    "sectionLabel": { "$ref": "../base.schema.json#/properties/sectionLabel" },
    "title": { "$ref": "../base.schema.json#/properties/title" },
    "subtitle": { "$ref": "../base.schema.json#/properties/subtitle" },
    "sourceChapterIds": { "$ref": "../base.schema.json#/properties/sourceChapterIds" },
    "fieldProvenance": { "$ref": "../base.schema.json#/properties/fieldProvenance" },
    "problem": { "$ref": "#/$defs/ContentBlock" },
    "solution": { "$ref": "#/$defs/ContentBlock" },
    "currentState": { "$ref": "#/$defs/ContentBlock" },
    "targetState": { "$ref": "#/$defs/ContentBlock" }
  },
  "required": [
    "schema_version",
    "layoutId",
    "title",
    "sourceChapterIds",
    "problem",
    "solution",
    "currentState",
    "targetState"
  ],
  "$defs": {
    "ContentBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
