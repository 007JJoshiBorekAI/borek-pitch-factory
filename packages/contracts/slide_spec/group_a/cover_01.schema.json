{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borek.ai/schemas/slide_spec/group_a/cover_01/v1.0",
  "title": "Cover01SlideSpec",
  "description": "BT-4: content contract for the COVER_01 Borek layout.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    { "$ref": "../base.schema.json#/$defs/SlideSpecBase" }
  ],
  "properties": {
    "schema_version": { "$ref": "../base.schema.json#/properties/schema_version" },
    "slideId": { "$ref": "../base.schema.json#/properties/slideId" },
    "layoutId": { "const": "COVER_01" },
    "sectionLabel": { "$ref": "../base.schema.json#/properties/sectionLabel" },
    "title": { "$ref": "../base.schema.json#/properties/title" },
    "subtitle": { "$ref": "../base.schema.json#/properties/subtitle" },
    "sourceChapterIds": { "$ref": "../base.schema.json#/properties/sourceChapterIds" },
    "fieldProvenance": { "$ref": "../base.schema.json#/properties/fieldProvenance" },
    "statBadges": {
      "type": "array",
      "description": "Semantic statistics shown on the cover; item-count limits are defined separately in BT-15.",
      "items": { "$ref": "#/$defs/StatBadge" }
    }
  },
  "required": ["schema_version", "layoutId", "title", "subtitle", "sourceChapterIds", "statBadges"],
  "$defs": {
    "StatBadge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
