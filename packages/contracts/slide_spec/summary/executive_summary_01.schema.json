{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borek.ai/schemas/slide_spec/summary/executive_summary_01/v1.0",
  "title": "ExecutiveSummary01SlideSpec",
  "description": "JJ-23: semantic headline-plus-highlights contract for the EXECUTIVE_SUMMARY_01 Borek layout.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    { "$ref": "../base.schema.json#/$defs/SlideSpecBase" }
  ],
  "properties": {
    "schema_version": { "$ref": "../base.schema.json#/properties/schema_version" },
    "slideId": { "$ref": "../base.schema.json#/properties/slideId" },
    "layoutId": { "const": "EXECUTIVE_SUMMARY_01" },
    "sectionLabel": { "$ref": "../base.schema.json#/properties/sectionLabel" },
    "title": { "$ref": "../base.schema.json#/properties/title" },
    "subtitle": { "$ref": "../base.schema.json#/properties/subtitle" },
    "sourceChapterIds": { "$ref": "../base.schema.json#/properties/sourceChapterIds" },
    "fieldProvenance": { "$ref": "../base.schema.json#/properties/fieldProvenance" },
    "headline": {
      "type": "string",
      "minLength": 1,
      "description": "One-sentence decision statement shown in the lead band."
    },
    "highlights": {
      "type": "array",
      "description": "Key takeaways; item-count limits are defined separately in JJ-23 constraints.",
      "items": { "$ref": "#/$defs/Highlight" }
    }
  },
  "required": [
    "schema_version",
    "layoutId",
    "title",
    "sourceChapterIds",
    "headline",
    "highlights"
  ],
  "$defs": {
    "Highlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
