{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borek.ai/schemas/slide_spec/group_b/process_flow_01/v1.0",
  "title": "ProcessFlow01SlideSpec",
  "description": "JJ-1: numbered sequence of phases for the PROCESS_FLOW_01 Borek layout.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    { "$ref": "../base.schema.json#/$defs/SlideSpecBase" }
  ],
  "properties": {
    "schema_version": { "$ref": "../base.schema.json#/properties/schema_version" },
    "slideId": { "$ref": "../base.schema.json#/properties/slideId" },
    "layoutId": { "const": "PROCESS_FLOW_01" },
    "sectionLabel": { "$ref": "../base.schema.json#/properties/sectionLabel" },
    "title": { "$ref": "../base.schema.json#/properties/title" },
    "subtitle": { "$ref": "../base.schema.json#/properties/subtitle" },
    "sourceChapterIds": { "$ref": "../base.schema.json#/properties/sourceChapterIds" },
    "fieldProvenance": { "$ref": "../base.schema.json#/properties/fieldProvenance" },
    "phases": {
      "type": "array",
      "description": "Numbered process phases; item-count limits are defined separately in JJ-10.",
      "items": { "$ref": "#/$defs/ProcessPhase" }
    }
  },
  "required": ["schema_version", "layoutId", "title", "sourceChapterIds", "phases"],
  "$defs": {
    "ProcessPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "name", "description"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based sequence position in the process flow."
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
