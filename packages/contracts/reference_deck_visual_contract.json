    "footer_left_text": "Borek Solutions Group · boreksolutions.de · Confidential",
    "footer_color_hex": "9AA0B3",
    "content_logo_anchor": "top_right",
    "cover_logo_anchor": "top_left",
    "font_family": "Inter",
    "forbidden_style_rules": [
      "gradients_on_cards",
      "coloured_strokes_on_cards",
      "shadows_on_cards",
      "logo_recolour",
      "logo_stretch"
    ]
  },
  "layout_map_required": true,
  "layout_map_path": "packages/contracts/gamma_arbios_layout_map.json",
  "visual_acceptance_requires_render_evidence": true
}
