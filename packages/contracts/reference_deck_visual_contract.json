{
  "schema_version": "1.0",
  "description": "Deterministic visual contract checks derived from the Arbios HTML master. Structural and token checks only; pixel render comparison remains a separate QA step.",
  "authority": "packages/contracts/borek_design_tokens.json",
  "design_contract_version": "2.0",
  "deterministic_checks": {
    "canvas_dimensions": { "width_px": 1920, "height_px": 1080 },
