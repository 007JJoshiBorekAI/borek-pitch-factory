{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borek.ai/schemas/followup_extraction/v1.0",
  "title": "FollowupExtraction",
  "description": "JJ-32: one transcript to one follow-up JSON object. Freeze this so MS-32 and BT-33 build against fixtures. Content is stated facts only — never inferred, completed or embellished. project_name is null here; MS-32 supplies it from project statics. prompt_version is stamped on the extraction call (ES-32).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_version",
    "meeting_topic",
    "meeting_date",
    "project_name",
    "participants",
    "key_points",
    "decisions",
    "action_items",
    "open_questions",
    "next_meeting",
    "confidence",
    "review_flags"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "description": "e.g. followup-extraction:v1. Persisted on the extraction call."
    },
    "meeting_topic": {
      "type": "string",
      "minLength": 1,
      "description": "2–4 words, e.g. Requirements Workshop."
    },
    "meeting_date": {
      "type": "string",
      "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{4}$",
      "description": "DD.MM.YYYY. Calendar value when the pipeline has it; otherwise from the transcript."
    },
    "project_name": {
      "type": ["string", "null"],
      "description": "Always null in extraction. MS-32 overlays project statics; the model must not guess."
    },
    "participants": {
      "type": "array",
      "items": { "$ref": "#/$defs/Participant" }
    },
    "key_points": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Outcome, not topic. Maximum 20 words. Surplus is dropped."
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "action_items": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/ActionItem" }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_meeting": {
      "oneOf": [
        { "$ref": "#/$defs/NextMeeting" },
        { "type": "null" }
      ]
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "review_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "Participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "organisation"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "organisation": {
          "type": ["string", "null"]
        }
      }
    },
    "ActionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "owner", "due"],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1,
          "description": "Verb-first commitment someone actually made."
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Named person or organisation stated in the transcript. Unclear owners are open_questions, not actions."
        },
        "due": {
          "type": "string",
          "pattern": "^([0-9]{2}\\.[0-9]{2}\\.[0-9]{4}|TBD)$",
          "description": "DD.MM.YYYY when a date was named; TBD otherwise. Never a guessed date."
        }
      }
    },
    "NextMeeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "time"],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{4}$"
        },
        "time": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_points", "action_items"],
      "properties": {
        "key_points": {
          "type": "string",
          "enum": ["high", "low"]
        },
        "action_items": {
          "type": "string",
          "enum": ["high", "low"]
        }
      }
    }
  }
}
