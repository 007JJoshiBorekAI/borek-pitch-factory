{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borek.ai/contracts/ppt2_context.schema.json",
  "title": "Ppt2Context",
  "description": "BT-46 read-only context for a future PPT #2. Sources stay separate. This object is assembled on demand and is not persisted. It is not a slide deck and not a blended prompt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "opportunity_id",
    "assembled_at",
    "source_priority",
    "notes_revision_matches_extraction",
    "sources",
    "missing_sources",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "opportunity_id": { "type": "string", "format": "uuid" },
    "assembled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this view was assembled. It is not a stored revision."
    },
    "source_priority": {
      "type": "array",
      "description": "Fixed authority order. Earlier sources outrank later sources when a consumer must choose between conflicting claims. BT-46 does not merge those claims.",
      "const": [
        "approved_discovery",
        "personal_notes",
        "meeting_extraction",
        "selected_use_cases"
      ]
    },
    "notes_revision_matches_extraction": {
      "description": "True when the extraction's personal-notes revision is the current notes revision, including both absent. not_applicable when no extraction exists. False means the extraction does not contain the current notes.",
      "oneOf": [
        { "type": "boolean" },
        { "const": "not_applicable" }
      ]
    },
    "sources": { "$ref": "#/$defs/Sources" },
    "missing_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["approved_discovery", "personal_notes", "meeting_extraction"]
      }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/Warning" }
    }
  },
  "$defs": {
    "Sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_discovery",
        "meeting_extraction",
        "personal_notes",
        "selected_use_cases"
      ],
      "properties": {
        "approved_discovery": { "$ref": "#/$defs/ApprovedDiscoverySource" },
        "meeting_extraction": { "$ref": "#/$defs/MeetingExtractionSource" },
        "personal_notes": { "$ref": "#/$defs/PersonalNotesSource" },
        "selected_use_cases": { "$ref": "#/$defs/SelectedUseCasesSource" }
      }
    },
    "ApprovedDiscoverySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "version_id",
        "version_number",
        "document_id",
        "approved_at",
        "paper_json"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["available", "missing"] },
        "version_id": { "type": ["string", "null"], "format": "uuid" },
        "version_number": { "type": ["integer", "null"] },
        "document_id": { "type": ["string", "null"], "format": "uuid" },
        "approved_at": { "type": ["string", "null"], "format": "date-time" },
        "paper_json": {
          "type": ["object", "null"],
          "description": "Immutable approved Discovery Paper snapshot. The working draft is never copied here."
        }
      }
    },
    "MeetingExtractionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "transcript_id",
        "personal_notes_updated_at",
        "extraction"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["available", "missing"] },
        "transcript_id": { "type": ["string", "null"], "format": "uuid" },
        "personal_notes_updated_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Notes revision stored when the extraction was generated. Null means the extraction used no notes."
        },
        "extraction": {
          "type": ["object", "null"],
          "description": "Stored BT-44 extraction object. Not regenerated by BT-46."
        }
      }
    },
    "PersonalNotesSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "text", "updated_at"],
      "properties": {
        "status": { "type": "string", "enum": ["available", "missing"] },
        "text": { "type": ["string", "null"] },
        "updated_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "SelectedUseCasesSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "use_case_ids", "use_cases"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["empty", "available", "partial"],
          "description": "empty means no ids are selected. available means every id resolved. partial means at least one selected id is unresolved."
        },
        "use_case_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "use_cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/SelectedUseCase" }
        }
      }
    },
    "SelectedUseCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "status",
        "document_id",
        "document_version",
        "document_type",
        "service_key",
        "statement",
        "payload",
        "corpus_id",
        "corpus_version"
      ],
      "properties": {
        "fact_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["resolved", "unresolved"] },
        "document_id": { "type": ["string", "null"] },
        "document_version": { "type": ["string", "null"] },
        "document_type": { "type": ["string", "null"] },
        "service_key": { "type": ["string", "null"] },
        "statement": { "type": ["string", "null"] },
        "payload": { "type": ["object", "null"] },
        "corpus_id": { "type": ["string", "null"] },
        "corpus_version": { "type": ["string", "null"] }
      }
    },
    "Warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "DISCOVERY_NOT_APPROVED",
            "MEETING_EXTRACTION_MISSING",
            "MEETING_EXTRACTION_NOTES_STALE",
            "USE_CASE_UNRESOLVED"
          ]
        },
        "fact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Present only for USE_CASE_UNRESOLVED, in stored selection order."
        }
      }
    }
  }
}
