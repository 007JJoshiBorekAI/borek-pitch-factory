        "COMPLIANCE_01",
        "TIMELINE_01",
        "MILESTONES_01",
        "TEAM_FTE_01",
        "SUCCESS_METRICS_01",
        "OPEN_QUESTIONS_01",
        "NEXT_STEPS_01"
      ],
      "pricing_permitted": false,
      "client_logo": true,
      "fact_kinds": ["service", "reference", "staffing"],
      "slot_overrides": {}
    },
    "concretisation": {
      "label": "Concretisation",
      "template_id": "borek-branded-standard",
      "cards": [
        "COVER_01",
        "EXECUTIVE_SUMMARY_01",
        "CONTEXT_01",
        "PROBLEM_SOLUTION_01",
        "PROCESS_FLOW_01",
