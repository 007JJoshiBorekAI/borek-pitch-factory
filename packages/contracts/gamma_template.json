{
  "schema_version": "1.0",
    "description": "JJ-26 / JJ-31: the branded Borek Gamma template. Branding is locked in the template and never sent per request; only the named content slots below vary per client. stage_profiles select which cards, logo, and pricing facts apply at each journey stage. Slot source chapters are a subset of the layout's allowed chapters in the internal renderer, so both engines cite the same Framework evidence.",
  "template_id": "borek-branded-standard",
  "template_version": "v1",
  "branding": {
    "locked": true,
    "owner": "Borek CI sheet",
    "ci_sheet": "docs/gamma/JJ26_BOREK_GAMMA_TEMPLATE.md#ci-sheet",
    "theme_id_setting": "GAMMA_THEME_ID",
    "template_id_setting": "GAMMA_TEMPLATE_ID",
    "locked_keys": [
      "brand_color",
      "theme",
      "font",
      "logo_override",
      "template_css",
      "master_id"
    ]
  },
  "client_logo": {
    "slot": "cover.client_logo",
    "rules_doc": "docs/gamma/JJ27_CLIENT_LOGO_PLACEMENT.md",
    "cards": ["cover", "closing"],
    "position": "bottom_right",
    "max_height_pct": 6.0,
    "min_clear_space_pct": 3.0,
    "co_brand_with_borek_logo": true,
    "quality_gate": {
      "min_edge_px": 128,
      "min_placement_area_px": 24576,
      "max_aspect_ratio": 8.0,
      "opaque_formats": ["image/jpeg"]
    },
    "fallbacks": {
      "missing": "client_name_wordmark",
      "poor_quality": "client_name_wordmark",
      "opaque_on_dark_card": "white_plate"
    },
    "signed_url_prefixes": []
  },
  "stage_profiles": {
    "first_contact": {
      "label": "First contact",
      "template_id": "borek-branded-standard",
      "cards": [
        "COVER_01",
        "EXECUTIVE_SUMMARY_01",
        "CONTEXT_01",
        "PROBLEM_SOLUTION_01",
        "NEXT_STEPS_01"
      ],
      "pricing_permitted": false,
      "client_logo": false,
      "fact_kinds": ["service"],
      "slot_overrides": {
        "context.summary": { "source_chapter_ids": ["1"] },
        "problem_solution.body": { "source_chapter_ids": ["4"] }
      }
    },
    "deepening": {
      "label": "Deepening",
      "template_id": "borek-branded-standard",
      "cards": [
        "COVER_01",
        "EXECUTIVE_SUMMARY_01",
        "CONTEXT_01",
        "PROBLEM_SOLUTION_01",
        "PROCESS_FLOW_01",
        "SCOPE_01",
