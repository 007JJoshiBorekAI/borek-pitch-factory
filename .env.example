# Borek AI Suite — environment template (AT-51)
# Copy to .env at the repository root, fill values, then run locally or: docker compose up --build
#
# Required keys are marked (required). Optional keys have defaults or are only needed in specific setups.

# -----------------------------------------------------------------------------
# Supabase — project credentials (required for API/worker when API_DATA_BACKEND=supabase)
# -----------------------------------------------------------------------------

# Hosted Supabase project URL, e.g. https://YOUR_REF.supabase.co (required)
SUPABASE_URL=

# Public anon key from Supabase Dashboard > Project Settings > API (required; safe in browser)
SUPABASE_ANON_KEY=

# Service role key for server-side PostgREST/admin operations — never expose to the browser (required)
SUPABASE_SERVICE_ROLE_KEY=

# Legacy HS256 JWT secret for unit tests only; production auth uses JWKS from SUPABASE_URL (optional)
SUPABASE_JWT_SECRET=

# Postgres password from Supabase Dashboard > Database; used to build DATABASE_URL when set (optional)
SUPABASE_DB_PASSWORD=

# Session pooler host (IPv4), e.g. aws-0-eu-central-1.pooler.supabase.com — use when direct db.* host fails (optional)
# Session-mode pooler host from Dashboard > Connect > Connection pooling (IPv4; required on Windows)
SUPABASE_DB_POOLER_HOST=

# Full Postgres URI; overrides built URL when pasted from Dashboard > Database > Connection string (optional)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.PROJECT_REF.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# LLM providers — server-side only (required by API config; worker generation stubs)
# -----------------------------------------------------------------------------

# Anthropic API key for framework synthesis jobs (required)
ANTHROPIC_API_KEY=

# OpenAI API key for live planning, slide generation, and compression (required only when AI_EXECUTION_MODE=live)
OPENAI_API_KEY=

# OpenAI model for Stage B planning and slide generation (optional, default: gpt-4.1-mini)
OPENAI_PRESENTATION_MODEL=gpt-4.1-mini

# -----------------------------------------------------------------------------
# API & worker (FastAPI + Celery) — apps/services/api
# -----------------------------------------------------------------------------

# Data store backend: supabase (production) or memory (pytest only) (optional, default: supabase)
API_DATA_BACKEND=supabase

# Deployment safety profile. Demo seeding always refuses when this is production.
RUNTIME_PROFILE=development

# Explicit opt-in for `npm run seed:demo` (optional, default: false)
DEMO_DATA_ENABLED=false

# AI execution: fixture keeps local/tests deterministic; live invokes OpenAI/Claude providers.
# Production manual testing with real transcripts MUST use live on API and worker (see below).
AI_EXECUTION_MODE=fixture

# Bind address for uvicorn when running API outside Docker (optional, default: 0.0.0.0)
API_HOST=0.0.0.0

# API listen port when running outside Docker (optional, default: 8000)
API_PORT=8000

# Redis broker and Celery result backend URL (required; use redis://redis:6379/0 in Docker Compose)
REDIS_URL=redis://redis:6379/0

# Base URL of the TypeScript renderer HTTP service (required; use http://renderer:4000 in Docker Compose)
RENDERER_URL=http://renderer:4000

# Renderer request timeout in seconds (optional, default: 120)
RENDERER_TIMEOUT_SECONDS=120

# live calls the renderer; fixture is reserved for isolated unit tests
RENDERER_EXECUTION_MODE=live

# Private artifact directory shared by API and worker
ARTIFACT_ROOT=/artifacts

# Presentation engine: internal keeps the existing renderer; gamma runs the AT-60 Gamma stage (optional, default: internal)
PRESENTATION_ENGINE=internal

# Gamma execution: fixture is deterministic; live calls public-api.gamma.app (optional, default: fixture)
GAMMA_EXECUTION_MODE=fixture

# Gamma API key from developers.gamma.app — required only for live Gamma (optional)
GAMMA_API_KEY=sk-gamma-HbGrduO7M6k8G3z0Gtb6XDJv11SSKdQpt1qq0ka7Aiw

# Gamma API base URL (optional, default: https://public-api.gamma.app)
GAMMA_API_BASE_URL=https://public-api.gamma.app

# Borek Pitch Theme id for live generations (optional, default: 4kv51cbpy4xonmj)
GAMMA_THEME_ID=4kv51cbpy4xonmj

# Gamma-side id of the JJ-26 branded template (optional; empty until it is built
# in the Gamma workspace — see docs/gamma/JJ26_BOREK_GAMMA_TEMPLATE.md)
GAMMA_TEMPLATE_ID=g_o2guwb3zh541ihu

# Gamma generate/poll timeout in seconds (optional, default: 180)
GAMMA_TIMEOUT_SECONDS=180

# HTTPS origin Gamma can reach for JJ-29 signed client-logo fetches (optional).
# Example: https://api.example.com  — http:// is rejected. Empty falls back to the client-name wordmark.
PUBLIC_API_BASE_URL=

# HMAC secret for signed logo URLs (optional; SUPABASE_JWT_SECRET is used when empty)
CLIENT_LOGO_SIGNING_SECRET=

# Lifetime of a signed logo URL in seconds (optional, default: 900)
CLIENT_LOGO_SIGNED_URL_TTL_SECONDS=900

# Artifact filing destination: in_app writes under ARTIFACT_ROOT/enterprise; live uses the O2 repository (optional, default: in_app)
FILING_DESTINATION=in_app

# Enterprise repository base URL once O2 names it — required only when FILING_DESTINATION=live (optional)
ENTERPRISE_REPOSITORY_URL=

# Enterprise repository credential once O2 issues it — required only when FILING_DESTINATION=live (optional)
ENTERPRISE_REPOSITORY_TOKEN=

# Enterprise repository timeout in seconds (optional, default: 30)
ENTERPRISE_REPOSITORY_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Renderer service — apps/renderer (PptxGenJS + AT-9 preview pipeline)
# -----------------------------------------------------------------------------

# HTTP port for renderer health/render service (optional, default: 4000)
RENDERER_PORT=4000

# Explicit path to LibreOffice soffice binary when not on PATH — used by AT-9 preview pipeline (optional)
SOFFICE_PATH=

# Alias for SOFFICE_PATH supported by libreoffice_pipeline.ts (optional)
LIBREOFFICE_PATH=

# Explicit path to pdftoppm (poppler) when not on PATH — used by AT-9 PNG extraction (optional)
PDFTOPPM_PATH=

# -----------------------------------------------------------------------------
# Next.js web — apps/web (browser-exposed vars must be NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------

# Public API base URL as seen by the browser — use http://localhost:8000 for local dev (required for UI)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mirror of SUPABASE_URL for client-side Supabase auth (required for /login; auto-mirrored from SUPABASE_URL in next.config)
NEXT_PUBLIC_SUPABASE_URL=

# Mirror of SUPABASE_ANON_KEY for client-side Supabase auth (required for /login; auto-mirrored in next.config)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Docker note: NEXT_PUBLIC_* values are baked into the web image at build time.
# After changing Supabase keys, rebuild: docker compose build --no-cache web

# Local-only bearer token bypass for API calls when Supabase sign-in is not configured — never commit a real token (optional)
NEXT_PUBLIC_DEV_ACCESS_TOKEN=

# Next.js dev server port when running outside Docker (optional, default: 3000; maps to PORT in web container)
WEB_PORT=3000

# Web app URL used by scripts/e2e_upload_smoke.py (optional, default: http://localhost:3000)
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Docker Compose — host port overrides (optional; defaults match values below)
# -----------------------------------------------------------------------------

# Host port published for Redis (optional, default: 6379)
REDIS_PUBLISH_PORT=6379

# Host port published for API (optional, default: 8000)
API_PUBLISH_PORT=8000

# Host port published for Next.js web (optional, default: 3000)
WEB_PUBLISH_PORT=3000

# Host port published for renderer (optional, default: 4000)
RENDERER_PUBLISH_PORT=4000

# Process PORT inside the web container — set from WEB_PORT by docker-compose (optional, default: 3000)
PORT=3000

# -----------------------------------------------------------------------------
# Live pipeline verification (production manual testing)
# -----------------------------------------------------------------------------
#
# 1. Set AI_EXECUTION_MODE=live and RENDERER_EXECUTION_MODE=live in .env
# 2. docker compose up — API and worker both load .env via env_file (no compose override)
# 3. Verify: Invoke-WebRequest http://127.0.0.1:8000/health/runtime
#    Expect ai_execution_mode=live; warnings=[] when OPENAI_API_KEY is set
# 4. fixture + supabase produces the same deterministic 5-slide deck every transcript

# -----------------------------------------------------------------------------
# Development, CI, and integration tests only
# -----------------------------------------------------------------------------

# Set to 1 to run Supabase integration tests in tests/integration/api (optional)
RUN_SUPABASE_INTEGRATION=

# AT-38 live RLS user A email (optional; required only when RUN_SUPABASE_INTEGRATION=1)
RLS_TEST_USER_A_EMAIL=

# AT-38 live RLS user A password (optional; required only when RUN_SUPABASE_INTEGRATION=1)
RLS_TEST_USER_A_PASSWORD=

# AT-38 live RLS user B email (optional; required only when RUN_SUPABASE_INTEGRATION=1)
RLS_TEST_USER_B_EMAIL=

# AT-38 live RLS user B password (optional; required only when RUN_SUPABASE_INTEGRATION=1)
RLS_TEST_USER_B_PASSWORD=

# E2E smoke test credentials for scripts/e2e_upload_smoke.py (optional)
E2E_TEST_EMAIL=

# E2E smoke test credentials for scripts/e2e_upload_smoke.py (optional)
E2E_TEST_PASSWORD=
