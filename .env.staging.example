# Staging-only environment overrides for TSK-014 Gamma theme validation.
# Copy relevant lines into a staging deployment .env — never into production.
#
# Production continues to use the defaults in .env.example / config.py until
# visual acceptance is recorded for the new theme.

# --- Gamma presentation engine (staging) ---
PRESENTATION_ENGINE=gamma
GAMMA_EXECUTION_MODE=live

# Jaya / schema 2.0 theme (replaces legacy 4kv51cbpy4xonmj on staging only)
GAMMA_THEME_ID=f5ix6vkbsmlsqg1

# Existing JJ-26 branded template — confirm with workspace owner before staging run
GAMMA_TEMPLATE_ID=g_o2guwb3zh541ihu

# Required for live Gamma generations on staging
GAMMA_API_KEY=

# HTTPS origin Gamma can reach for JJ-29 signed client-logo fetches (deepening stage)
PUBLIC_API_BASE_URL=

# Leave unset until a staging deck passes visual comparison against the Arbios master
# GAMMA_THEME_CONTRACT_VERSION=2.0

# Keep staging off production safety rails
RUNTIME_PROFILE=development
