{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "src/**/*.ts",
    "validation/**/*.ts",
    "scripts/**/*.ts",
    "design_system/**/*.ts",
    "layouts/**/*.ts",
    "../../tests/golden_deck/group_a/**/*.ts",
    "../../tests/golden_deck/group_b/**/*.ts"
  ]
}
