# Next.js local overrides — prefer the repo-root .env.example (AT-51).
# next.config.ts mirrors SUPABASE_URL → NEXT_PUBLIC_SUPABASE_URL automatically when you run from the monorepo root.
#
# Copy only if you run `npm run dev` from apps/web in isolation:
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEV_ACCESS_TOKEN=
